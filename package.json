{
  "name": "@difftim/keyring",
  "version": "2.1.4",
  "description": "https://github.com/hwchen/keyring-rs Node.js binding via https://napi.rs",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./index.js": "./index.js",
    "./keytar": {
      "types": "./keytar.d.ts",
      "default": "./keytar.js"
    },
    "./keytar.js": {
      "types": "./keytar.d.ts",
      "default": "./keytar.js"
    },
    "./keytar-compat": {
      "types": "./keytar-compat.d.ts",
      "default": "./keytar-compat.js"
    },
    "./keytar-compat.js": {
      "types": "./keytar-compat.d.ts",
      "default": "./keytar-compat.js"
    },
    "./package.json": "./package.json"
  },
  "repository": "https://github.com/difftim/keyring-node",
  "license": "MIT",
  "keywords": [
    "napi-rs",
    "NAPI",
    "N-API",
    "Rust",
    "node-addon",
    "node-addon-api"
  ],
  "files": [
    "index.d.ts",
    "index.js",
    "keytar.js",
    "keytar.d.ts",
    "keytar-compat.js",
    "keytar-compat.d.ts"
  ],
  "napi": {
    "binaryName": "keyring",
    "constEnum": false,
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin"
    ]
  },
  "engines": {
    "node": ">= 10"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "build:darwin": "napi build --platform --release --target aarch64-apple-darwin && napi build --platform --release --target x86_64-apple-darwin",
    "format": "run-p format:prettier format:rs format:toml",
    "format:prettier": "prettier . -w",
    "format:toml": "taplo format",
    "format:rs": "cargo fmt",
    "lint": "oxlint",
    "licenses": "node scripts/third-party-licenses.mjs",
    "prepublishOnly": "napi prepublish -t npm --no-gh-release",
    "test": "ava -s",
    "typecheck": "tsc --noEmit",
    "preversion": "napi build --platform && git add .",
    "version": "napi version"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.9.1",
    "@oxc-node/core": "^0.1.1",
    "@taplo/cli": "^0.7.0",
    "@types/node": "^26.5.1",
    "ava": "^8.0.1",
    "chalk": "^6.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "npm-run-all2": "^9.0.3",
    "oxlint": "^1.82.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.@(js|ts|tsx)": [
      "oxlint --fix"
    ],
    "*.@(js|ts|tsx|yml|yaml|md|json)": [
      "prettier --write"
    ],
    "*.toml": [
      "taplo format"
    ]
  },
  "ava": {
    "nodeArguments": [
      "--import",
      "@oxc-node/core/register"
    ],
    "extensions": [
      "ts"
    ],
    "timeout": "2m",
    "workerThreads": false,
    "environmentVariables": {
      "TS_NODE_PROJECT": "./tsconfig.json"
    }
  },
  "prettier": {
    "printWidth": 120,
    "semi": false,
    "trailingComma": "all",
    "singleQuote": true,
    "arrowParens": "always"
  },
  "packageManager": "yarn@4.18.1",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/Brooooooklyn"
  }
}
